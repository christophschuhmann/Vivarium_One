{
  "name": "vivarium",
  "version": "1.0.0",
  "description": "A warm, browser-based life-simulation sandbox: AI-driven characters live in illustrated worlds you create, narrate their days aloud, and can be nudged, rewound, exported and shared.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file=.env scripts/start.mjs",
    "start:plain": "node scripts/start.mjs",
    "music": "node --env-file=.env server/music_server.js",
    "music:setup": "node --env-file=.env scripts/setup-music.mjs",
    "seed": "node --env-file=.env scripts/seed_demo.js",
    "reset-demo": "node --env-file=.env scripts/reset_demo.js",
    "test:providers": "node scripts/test-providers.mjs",
    "test:music": "node scripts/test-music.mjs",
    "test:location-music": "node scripts/test-location-music.mjs",
    "test:storage": "node scripts/test-storage.mjs",
    "test:e2e": "node e2e/io_features.cjs && node e2e/timetravel.cjs && node e2e/scene.cjs",
    "test:settings": "node scripts/test-settings-browser.mjs",
    "living:setup": "node scripts/setup-living.mjs",
    "test:living": "node scripts/test-living.mjs",
    "test:living-social": "node scripts/test-living-social.mjs",
    "test:living-mind": "node scripts/test-living-mind.mjs",
    "benchmark:living": "node scripts/benchmark-living.mjs",
    "test:living-browser": "node scripts/test-living-browser.mjs",
    "test:living-biographies": "node scripts/test-living-biographies.mjs",
    "test:living-romance": "node scripts/test-living-romance.mjs",
    "test:living-wellbeing": "node scripts/test-living-wellbeing.mjs",
    "test:expanded": "node scripts/test-expanded-world.mjs",
    "test:expanded-semantics": "node scripts/test-expanded-semantics.mjs",
    "test:expanded-lifecycle": "node scripts/test-expanded-lifecycle.mjs",
    "review:expanded": "node scripts/review-expanded-world.mjs",
    "benchmark:expanded": "node scripts/benchmark-living.mjs",
    "test:expanded-regressions": "node scripts/test-expanded-regressions.mjs",
    "test:finance-care": "node scripts/test-finance-education-care.mjs",
    "test:finance-care-browser": "node scripts/test-finance-care-browser.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "better-sqlite3": "^12.11.1",
    "fastify": "^5.9.0",
    "playwright": "^1.61.1",
    "undici": "^7.28.0"
  }
}
