# Copy to .env and fill in. `npm start` loads this via node --env-file.

# New local installations start with a player's own API key, without an admin.
VIV_PERSONAL_MODE=1
# Bind a fresh local install to this computer. Use 0.0.0.0 for remote access.
VIV_HOST=127.0.0.1

# HyprLab API key — one key powers the LLM (gemini-3.5-flash), image generation
# (nano-banana-2), TTS (gemini-3.8-flash-tts) and ASR (whisper-1). https://hyprlab.io
HYPRLAB_API_KEY=

# HTTP port (default 8890)
#PORT=8890

# Where the SQLite DB + generated assets live (default: ./data)
#VIV_DATA_DIR=

# 1 = expose /api/test/* helper endpoints (never in production)
#TEST_MODE=

# 1 = deterministic mock providers: no external API calls, zero cost (CI)
#MOCK_PROVIDERS=

# Optional master secret for encrypting player-supplied provider keys at rest
# (BYOK, Settings → AI provider). If unset, a random secret is generated once and
# stored in the settings table. Set it to keep keys decryptable across re-installs.
#VIV_SECRET=

# The LAIONBox TTS server URL is NOT configured here — it's a model route in the
# database (admin console → Models → tts_laionbox base URL), like all model endpoints.

# Optional central OpenRouter credential; also editable in Admin → Models.
OPENROUTER_API_KEY=
# Recommended stable master secret for encrypted provider credentials.

# Optional: a different music dataset directory and external music search service.
#MUSIC_DATA_DIR=
#MUSIC_API_URL=http://127.0.0.1:8930
#MUSIC_PORT=8930
#MUSIC_AUTOSTART=1
#MUSIC_SEARCH_FIELD=bm25_situation
#VIV_PYTHON_BIN=/path/to/python
# VIV_PLAYER_EMAIL / VIV_PLAYER_PASSWORD customize the local account created by setup.
